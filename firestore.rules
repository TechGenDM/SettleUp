rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // Function to check if the user is a member of the group
    function isGroupMember(groupId) {
      return isAuthenticated() && 
             request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids;
    }

    // Groups Collection
    match /groups/{groupId} {
      // Create: user must be authenticated, and their UID must be in the new document's memberUids list
      allow create: if isAuthenticated() && 
                    request.auth.uid in request.resource.data.memberUids;
                    
      // Read & Update: user must currently be a member of the group
      allow read, update: if isAuthenticated() && 
                          request.auth.uid in resource.data.memberUids;
                          
      // Delete: Only the creator should be able to delete, or nobody. Let's restrict it to nobody for now to prevent accidental data loss
      allow delete: if false;
      
      // Expenses Subcollection
      match /expenses/{expenseId} {
        // Read: must be a member of the parent group
        allow read: if isGroupMember(groupId);
        
        // Create: must be a member of the parent group, and amount must be strictly positive
        allow create: if isGroupMember(groupId) && 
                      request.resource.data.amount > 0 &&
                      request.resource.data.amount is number;
                      
        // Update: must be a member, amount must stay positive
        allow update: if isGroupMember(groupId) && 
                      request.resource.data.amount > 0 &&
                      request.resource.data.amount is number;
                      
        // Delete: restrict deletion for audit trail integrity
        allow delete: if false;
      }
    }
    
    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
